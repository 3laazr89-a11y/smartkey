<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Intentionally no INTERNET permission: all keyboard data and prediction stay on-device. -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ClipboardActivity"
            android:exported="false"
            android:label="@string/clipboard_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".EmojiSearchActivity"
            android:exported="false"
            android:label="بحث الإيموجي"
            android:theme="@style/EmojiSearchOverlay"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

        <service
            android:name=".SmartKeyboardService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:directBootAware="true"
            android:isolatedProcess="false">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
