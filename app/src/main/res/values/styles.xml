<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#FF0F766E</item>
        <item name="android:colorPrimaryDark">#FF0B1F1E</item>
        <item name="android:colorAccent">#FF0F766E</item>
        <item name="android:statusBarColor">#FF0B1F1E</item>
